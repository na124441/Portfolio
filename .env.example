# Database Connection URL (Prisma / Local file store)
DATABASE_URL="file:./src/data/bytelogic/practice-db.json"

# ==============================================================================
# Dedicated Remote Execution Engine Configuration
# ==============================================================================
# The compiler / interpreter execution of C++ and Python runs on an isolated Docker-capable host.
# Next.js and Vercel communicate with this execution server through server-side API calls.
#
# Supported Engines:
# 1. Piston (https://github.com/engineer-man/piston) - default
#    Example: EXECUTION_SERVER_URL="http://your-vps-ip:2000"
#
# 2. Judge0 (https://github.com/judge0/judge0)
#    Example: EXECUTION_SERVER_URL="https://judge0-ce.p.rapidapi.com"
#
# Server-only environment variables (NEVER prefix with NEXT_PUBLIC_)
EXECUTION_SERVER_URL="http://localhost:2000"
EXECUTION_SERVER_TOKEN=""
EXECUTION_SERVER_TYPE="piston" # "piston" | "judge0"
